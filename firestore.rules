rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }
    
    // Test collection
    match /test/{docId} {
      allow read, write: if true;
    }

    // Public read and write for showcase shop products & categories
    match /categories/{categoryId} {
      allow read, write: if true;
    }
    
    match /products/{productId} {
      allow read, write: if true;
    }

    // Orders: allow customer creation, read their own or authenticated staff/owner
    match /orders/{orderId} {
      allow read, write: if true;
    }

    // Inventory Bales & Suppliers
    match /bales/{baleId} {
      allow read, write: if true;
    }

    match /suppliers/{supplierId} {
      allow read, write: if true;
    }

    // Finance & Expenses
    match /expense_accounts/{accountId} {
      allow read, write: if true;
    }

    match /expenses/{expenseId} {
      allow read, write: if true;
    }

    match /transactions/{transactionId} {
      allow read, write: if true;
    }

    match /item_logs/{logId} {
      allow read, write: if true;
    }

    match /customers/{customerId} {
      allow read, write: if true;
    }

    match /users/{userId} {
      allow read, write: if true;
    }

    match /{document=**} {
      allow read, write: if true;
    }
  }
}
